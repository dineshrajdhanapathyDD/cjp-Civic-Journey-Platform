# CockroachDB Cloud
COCKROACHDB_URL=postgresql://username:password@cluster-host:26257/cjp?sslmode=verify-full&sslrootcert=path/to/ca.crt
COCKROACHDB_CLUSTER_ID=your-cluster-id

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# CockroachDB MCP Server
COCKROACHDB_MCP_API_KEY=your-ccloud-api-key
COCKROACHDB_MCP_CLUSTER_NAME=cjp-cluster

# Application
APP_SECRET_KEY=your-secret-key-here
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# Vector Embeddings
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
