                    <mxGeometry x="500" y="410" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="proof" value="PROOF: CockroachDB Memory Layer Works&#10;&#10;The agent NEVER loses context.&#10;All state persists in CockroachDB.&#10;Tool calls are logged and visible.&#10;&#10;See: /activity endpoint&#10;See: /api/agent/actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
                    <mxGeometry x="500" y="520" width="280" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="activity" value="Agent Activity UI Shows:&#10;&#10;search_civic_memory → Vector Search&#10;create_civic_issue → CockroachDB MCP&#10;find_job_opportunities → Vector Search&#10;record_job_match → CockroachDB MCP&#10;get_issue_context → CockroachDB MCP&#10;get_issue_timeline → CockroachDB MCP&#10;consult_cockroachdb_skill → Agent Skills&#10;list_cockroachdb_skills → Agent Skills" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
                    <mxGeometry x="900" y="120" width="280" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="key" value="KEY INSIGHT:&#10;CockroachDB is NOT just a database.&#10;It IS the agent's persistent memory.&#10;&#10;Strands = Brain&#10;MCP = Bridge&#10;CockroachDB = Memory&#10;Vector Index = Understanding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="300" width="280" height="140" as="geometry"/>
                </mxCell>
